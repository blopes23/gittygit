{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gittygit",
  "version": "../package.json",
  "identifier": "dev.gittygit.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gittygit",
        "width": 1440,
        "height": 900,
        "minWidth": 950,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3M0FBRTFEMDZFMEY3N0UKUldSKzkrQUdIYTQ2TjVxSmtiRFZwTng0QXlsNnF4UGJBVmZWMGtHd0xUZCszL0hUNkY5Q051ZjIK",
      "endpoints": [
        "https://github.com/blopes23/gittygit/releases/latest/download/latest.json"
      ]
    }
  }
}
